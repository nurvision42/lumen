{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.dev/schemas/run.schema.json",
  "title": "lumen run record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "time", "command", "modelId", "mode", "status", "binding", "params", "calls", "response", "outputs"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$" },
    "time": { "type": "string" },
    "command": { "type": "array", "items": { "type": "string" } },
    "modelId": { "type": "string" },
    "mode": { "enum": ["dry-run", "execute", "mock"] },
    "status": { "enum": ["dry-run", "mock", "ok", "error", "running", "pending"] },
    "binding": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "baseUrl", "apiKeyEnv", "keyPresent"],
          "properties": {
            "provider": { "type": "string" },
            "baseUrl": { "type": "string" },
            "apiKeyEnv": { "type": "string" },
            "keyPresent": { "type": "boolean" },
            "group": { "type": "string" },
            "modelAlias": { "type": "string" },
            "source": { "enum": ["project", "global"] }
          }
        }
      ]
    },
    "params": {},
    "calls": {},
    "response": {},
    "outputs": { "type": "array", "items": { "type": "string" } },
    "error": { "type": "string" },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "taskId", "lastStatus", "videoFile", "receipt"],
      "properties": {
        "provider": { "type": "string" },
        "taskId": { "type": "string" },
        "lastStatus": { "type": "string" },
        "videoFile": { "type": "string" },
        "receipt": { "type": "string" },
        "pollUrl": { "type": "string" }
      }
    },
    "resumedAt": { "type": "array", "items": { "type": "string" } },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid"],
      "properties": {
        "pid": { "type": "integer" },
        "log": { "type": "string" },
        "exited": { "enum": ["clean"] }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "outFile"],
      "properties": {
        "provider": { "type": "string" },
        "outFile": { "type": "string" },
        "url": { "type": "string" },
        "taskId": { "type": "string" },
        "received": { "type": "boolean" }
      }
    },
    "claimed": { "type": "boolean" },
    "claimedAt": { "type": "string" },
    "claimedBy": { "enum": ["wait", "show"] }
  }
}
