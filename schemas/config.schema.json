{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.dev/schemas/config.schema.json",
  "title": "lumen config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "models": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/binding" }
    },
    "breakdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string" },
        "promptFile": { "type": "string", "minLength": 1 },
        "preferModels": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "level": { "type": "string", "minLength": 1 },
        "needAudio": { "type": "boolean" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ffmpeg": { "type": "string", "minLength": 1 },
        "ffprobe": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "apiKeyEnv"],
      "properties": {
        "provider": { "enum": ["yunqiao", "grsai", "haomao", "kitta", "mediakit", "beeftv"] },
        "baseUrl": { "type": "string", "minLength": 1 },
        "apiKeyEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "group": { "type": "string", "minLength": 1 },
        "modelAlias": { "type": "string", "minLength": 1 }
      }
    }
  }
}
